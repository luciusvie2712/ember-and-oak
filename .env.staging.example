# Documentation-only names. Store real values in GitHub/platform environment secrets.
DEPLOYMENT_ENV=staging
WEB_STAGING_URL=https://web-staging.example.invalid
ADMIN_STAGING_URL=https://admin-staging.example.invalid
API_STAGING_URL=https://api-staging.example.invalid

DATABASE_URL=postgresql://replace_with_user:replace_with_password@db.example.invalid:5432/replace_with_database
ERROR_TRACKING_DSN=
ANALYTICS_WRITE_KEY=

CONTENT_API_URL=https://api-staging.example.invalid/
NEXT_PUBLIC_API_URL=https://api-staging.example.invalid/

ADMIN_CONTENT_API_KEY=replace_with_at_least_32_random_characters
ADMIN_EDITOR_USERNAME=replace_with_admin_username
ADMIN_EDITOR_PASSWORD=replace_with_a_strong_password
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace_with_a_stable_32_byte_base64_key

WEB_REVALIDATION_URL=https://web-staging.example.invalid/api/content/revalidate
WEB_REVALIDATION_SECRET=replace_with_at_least_32_random_characters

ASSET_CDN_URL=https://cdn-staging.example.invalid/
IMAGE_CDN_URL=https://cdn-staging.example.invalid/
