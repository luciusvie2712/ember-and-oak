{
  "name": "@ember-and-oak/api",
  "version": "0.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:e2e": "pnpm db:migrate && pnpm db:seed && pnpm admin:e2e-seed && nest start --watch",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:integration": "pnpm db:migrate && pnpm db:seed && vitest run --config ./vitest.config.e2e.ts",
    "db:check": "pnpm build && node dist/database/check-database.js",
    "db:migrate": "pnpm build && node dist/database/migrate.js",
    "db:seed": "pnpm build && node dist/content/seed-content.js",
    "admin:bootstrap": "pnpm build && node dist/admin-auth/bootstrap-admin.js",
    "admin:e2e-seed": "pnpm build && node dist/admin-auth/seed-e2e-admin.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@ember-and-oak/types": "workspace:*",
    "@ember-and-oak/validation": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "dotenv": "17.2.2",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@ember-and-oak/config": "workspace:*",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.15.5",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.2"
  }
}
